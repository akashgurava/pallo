{
  "name": "pallo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "scrape": "tsx src/lib/server/scraper/index.ts",
    "scrape:details": "tsx src/lib/server/scraper/scrape-details.ts",
    "db:push": "drizzle-kit push",
    "db:reset": "rm -f pallo.db && drizzle-kit push",
    "lint": "eslint .",
    "format": "npx @tailwindcss/upgrade --force && prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.27.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "globals": "^17.8.0",
    "node-html-parser": "^9.0.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.4.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "svelte-range-slider-pips": "^4.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2"
  }
}
